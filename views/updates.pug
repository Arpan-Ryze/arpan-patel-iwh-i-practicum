doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Create a New Custom Object Record
    form(action="/update-cobj", method="POST")
      div
        label(for="name") Name:
        input(type="text", name="name", required=true)
      div
        label(for="bio") Bio:
        input(type="text", name="bio", required=true)
      div
        label(for="type") Type:
        input(type="text", name="type", required=true)
      div
        button(type="submit") Submit
    br
    a(href="/") Return to the homepage